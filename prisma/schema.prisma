// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Configurazione per il database delle forze dell'ordine (FDO)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modello per gli utenti (operatori delle forze dell'ordine)
model User {
  id         String   @id @default(cuid())
  name       String
  surname    String
  email      String   @unique
  password   String // Sarà hashed
  badge      String   @unique // Numero di matricola
  department String // Dipartimento (Polizia, Carabinieri, ecc.)
  deptId     Int?   // ID numerico del dipartimento (1=PdS, 2=CC, 3=GdF, 4=Procura)
  rank       String // Grado
  rankId     Int?   // ID numerico del grado all'interno del dipartimento
  discordId  String? @unique @db.VarChar(25) // Discord Snowflake ID (stringa per evitare perdita di precisione)
  image      String? // URL immagine profilo
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relazioni
  arrestsAsOfficer   Arrest[]      @relation("OfficerArrests")
  reportsAsOfficer   Report[]      @relation("OfficerReports")
  wantedAsOfficer    Wanted[]      @relation("OfficerWanted")
  weaponLicensesAsOfficer WeaponLicense[] @relation("OfficerWeaponLicenses")
  vatRegistrationsAsOfficer VatRegistration[] @relation("OfficerVatRegistrations")
  citizenNotes       CitizenNote[] @relation("OfficerCitizenNotes")
  tabletLinks        TabletUserLink[]
  apiTokens          ApiToken[]
  sessions           Session[]
  Account            Account[]

  @@map("fdo_users")
}

// NOTA: Il model GameUser (cittadini) è gestito dallo schema separato prisma/schema-iarp.prisma
// e accessibile tramite il client prismaIARP in src/lib/prisma-iarp.ts

// Modello per i token API che saranno usati per l'autenticazione di servizi esterni
model ApiToken {
  id        String    @id @default(cuid())
  token     String    @unique
  name      String // Nome descrittivo (es. "Bot Discord")
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  lastUsed  DateTime?
  userId    String // L'utente che ha creato il token
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fdo_api_tokens")
}

// Modelli per NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("fdo_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fdo_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("fdo_verification_tokens")
}

model CrimeCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("blue") // blue|red|green|yellow|purple|gray
  order       Int      @default(0)
  sectionId   String?  // ID of the normative section (e.g. "codice-penale")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  crimes      Crime[]

  @@map("fdo_crime_categories")
}

model Crime {
  id           String        @id @default(cuid())
  name         String
  description  String        @db.Text
  sentence     String        // e.g. "3 anni 6 mesi"
  fine         Int           @default(0) // sanzione amministrativa in €
  articleCode  String?       // es. "Art. 624 c.p."
  categoryId   String
  category     CrimeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@map("fdo_crimes")
}

// Modello per le impostazioni di sistema (chiave-valore)
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("fdo_settings")
}

// Modello per gli arresti
model Arrest {
  id                  String   @id @default(cuid())
  date                DateTime @default(now())
  location            String
  description         String   @db.Text
  charges             String   @db.Text
  sentence            String?  @db.Text // Pena detentiva cumulativa (es: "3 anni 6 mesi")
  fine                Int?     // Multa da pagare in euro
  citizenId           Int      // ID del cittadino (riferimento a database IARP)
  officerId           String   // ID dell'ufficiale (utente del sistema)
  incidentDescription String?  @db.Text // Descrizione dettagliata degli accaduti
  seizedItems         String?  @db.Text // Oggetti sequestrati
  department          String   // Dipartimento che ha effettuato l'arresto
  signingOfficers     Json?    // Array di ufficiali firmatari [{ id, name, badge }]
  accomplices         Json?    // Array di complici [{ id, name, birthDate }]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relazioni (solo con tabelle nello stesso database)
  officer User     @relation("OfficerArrests", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@map("fdo_arrests")
}

// Modello per i rapporti/denunce
model Report {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @default(now())
  description String
  type        String // Tipo di rapporto (furto, violenza, ecc.)
  location    String // Luogo dell'incidente
  isAnonymous Boolean  @default(false) // Rapporto anonimo o meno
  officerId   String
  citizenId   Int? // ID del cittadino denunciante (riferimento a database IARP)
  accusedId   Int? // ID del cittadino accusato (riferimento a database IARP)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relazioni (solo con tabelle nello stesso database)
  officer User      @relation("OfficerReports", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@index([accusedId])
  @@map("fdo_reports")
}

// Modello per i ricercati
model Wanted {
  id             String   @id @default(cuid())
  citizenId      Int      // ID del cittadino ricercato (riferimento a database IARP)
  crimes         String   @db.Text // Elenco dei reati contestati, separati da virgola
  description    String   @db.Text // Descrizione delle attività criminali o altri dettagli
  lastSeen       String?  // Ultimo avvistamento (luogo, data)
  dangerLevel    String   // Livello di pericolosità: "low", "medium", "high", "extreme"
  bounty         Int?     // Eventuale taglia sulla cattura
  status         String   @default("active") // Stato: "active", "captured", "closed"
  notes          String?  @db.Text // Note aggiuntive
  imageUrl       String?  // URL immagine del ricercato
  officerId      String   // ID dell'operatore che ha inserito il ricercato
  insertedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relazioni (solo con tabelle nello stesso database)
  officer User     @relation(name: "OfficerWanted", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@index([officerId])
  @@map("fdo_wanted")
}

// Modello per i porto d'armi
model WeaponLicense {
  id                String   @id @default(cuid())
  licenseNumber     String   @unique // Numero porto d'armi (es: "PDA-2024-001234")
  citizenId         Int      // ID del cittadino (riferimento a database IARP)
  licenseType       String   // Tipo: "sport_target", "hunting", "defense", "collection", "carry"
  issueDate         DateTime? // Data di rilascio (null finché la richiesta non viene attivata)
  expiryDate        DateTime? // Data di scadenza (null finché la richiesta non viene attivata)
  status            String   @default("pending") // Stato: "pending", "active", "expired", "suspended", "revoked"
  issuingAuthority  String   // Autorità di rilascio (es: "Questura di Roma")
  restrictions      String?  @db.Text // Eventuali restrizioni (es: "Solo tiro al bersaglio")
  authorizedWeapons Json?    // Array di armi autorizzate [{type, caliber, model, serialNumber}]
  notes             String?  @db.Text // Note aggiuntive
  suspensionReason  String?  @db.Text // Motivo sospensione/revoca
  officerId         String   // ID dell'operatore che ha inserito/modificato
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relazioni (solo con tabelle nello stesso database)
  officer User     @relation("OfficerWeaponLicenses", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@index([licenseNumber])
  @@index([status])
  @@index([officerId])
  @@map("fdo_weapon_licenses")
}

// Modello per le Partite IVA
model VatRegistration {
  id                 String    @id @default(cuid())
  registrationNumber String    @unique // Numero P.IVA (es: "PIVA-20240101-000001-1234")
  citizenId          Int       // ID del cittadino (riferimento a database IARP)
  businessName       String    // Nome/ragione sociale attività
  businessType       String    // Tipo attività
  taxRegime          String    // Regime fiscale
  status             String    @default("pending") // pending, active, suspended, revoked
  issueDate          DateTime? // Data apertura (null finché non attivata)
  issuingAuthority   String    // Autorità di rilascio
  notes              String?   @db.Text
  suspensionReason   String?   @db.Text
  officerId          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  officer User @relation("OfficerVatRegistrations", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@index([registrationNumber])
  @@index([status])
  @@index([officerId])
  @@map("fdo_vat_registrations")
}

// Link persistente tra identificatori FiveM e utente FDO
model TabletUserLink {
  id                String   @id
  userId            String   @unique
  license           String?  @unique
  discord           String?  @unique
  steam             String?  @unique
  fivem             String?  @unique
  firstLinkedAt     DateTime @default(now())
  lastLoginAt       DateTime @default(now())
  lastCharacterName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("fdo_tablet_user_links")
}

// Modello per le note sui cittadini
model CitizenNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  citizenId BigInt
  officerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officer User @relation("OfficerCitizenNotes", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([citizenId])
  @@index([officerId])
  @@map("fdo_citizen_notes")
}

model FdoDepartment {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  discordRoleId String    @default("0") @db.VarChar(25)
  ranks         FdoRank[]

  @@map("fdo_departments")
}

model FdoRank {
  id            Int           @id @default(autoincrement())
  deptId        Int
  rankOrder     Int
  name          String        @db.VarChar(200)
  discordRoleId String        @default("0") @db.VarChar(25)
  department    FdoDepartment @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@unique([deptId, rankOrder])
  @@map("fdo_ranks")
}
